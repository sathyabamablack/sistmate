{
  "name": "@usp/papers-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Question papers API: metadata in D1, files in Workers KV. Not an npm workspace; deployed with wrangler.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply sistmate-papers --local",
    "db:migrate:remote": "wrangler d1 migrations apply sistmate-papers --remote",
    "typecheck": "tsc --noEmit"
  }
}
