# deps
node_modules/
.pnp.*

# builds
.next/
.next-*/
.build-lock/
dist/
out/
build/

# env & secrets — NEVER commit credentials or session tokens
.env
.env.local
.env.*.local
*.session
.secrets/
**/data/cache/

# logs
*.log
npm-debug.log*

# os / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# captured portal pages (your own private data — keep out of git)
captures/

# typescript incremental build state
*.tsbuildinfo

# playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# generated by npm run build:extension (served at /erp-connector.zip)
apps/web/public/erp-connector.zip

# generated at build time by apps/web/scripts/inject-sw-version.mjs
apps/web/public/sw-version.js
# generated at build time by apps/web/scripts/list-static-assets.mjs
apps/web/public/usp-assets.json
apps/web/.build-id

# vercel cli link state
.vercel/

.vercel
.env*

# browser snapshots from local Playwright MCP sessions
.playwright-mcp/
